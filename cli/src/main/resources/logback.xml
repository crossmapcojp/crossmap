<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="jp.co.crossmap.ChurchSearchEngine" level="INFO"/>
    <logger name="jp.co.crossmap.GeoNameResolver" level="WARN"/>
    <logger name="org.gnit" level="WARN"/>
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
